{
  "manifest_version": 3,
  "name": "Repo Guard - GitHub Repo Safety Scanner",
  "version": "1.0.0",
  "description": "Rates the safety of GitHub repositories: flags stealers, miners, obfuscated payloads, risky install scripts and malware lures.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*", "https://raw.githubusercontent.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "Repo Guard", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" } },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
